# Node deps
node_modules/
**/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Runtime / build outputs
dist/
build/
out/
**/dist/
**/build/
**/out/

# Next.js / frontend
.next/
.next/**

# TypeScript
*.tsbuildinfo

# Env files (ignore all envs but keep .env.example if present)
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Package managers / lockfiles (do NOT ignore lockfiles by default, comment out if you want to keep)
# pnpm-lock.yaml
# yarn.lock
# package-lock.json

# Coverage
coverage/
*.lcov

# Debug / temp
*.log
*.tmp
*.temp
tmp/
temp/

# Docker
docker-compose.override.yml
.docker/

# Vercel / Netlify / build caches
.vercel/
.netlify/
.cache/
.cache/**

# Prisma (keep migrations tracked; ignore generated client if needed)
node_modules/.prisma
**/node_modules/.prisma
prisma/.env

# Backend specific
backend/dist/
backend/node_modules/

# Frontend specific
frontend/.next/
frontend/node_modules/

# Misc keys/certs
*.pem
*.key
*.crt

# IDEs
.vscode/
.idea/

# Generated by package tools
.pnp
.pnp.js

# Optional: OS-specific swap files
*~
*.swp